# EditorConfig: every editor opens these files as UTF-8 with LF line endings.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{png,jpg,jpeg,gif,webp,woff,woff2,eot,ttf,otf,zip,tar,gz,tgz,wasm,ico}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
